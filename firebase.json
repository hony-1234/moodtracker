{
  "auth": {
    "authorizedDomains": [
      "localhost",
      "schoolmoodsystem.firebaseapp.com",
      "schoolmoodsystem.web.app"
    ],
    "providers": {
      "emailPassword": true
    }
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/sendPush",
        "function": "sendPushNotification"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": {
    "source": "functions",
    "codeifyVersion": "typescript"
  }
}
